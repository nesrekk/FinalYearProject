.DS_Store
__pycache__/
*.pyc
frontend/node_modules/
frontend/dist/
.venv/
venv/
.env
api/.env

# Raw Kaggle datasets (large, not source — regenerable from the original
# Kaggle downloads, shouldn't bloat the repo)
nba_data/kaggle_1947_present/
shots_data/kaggle_shot_data_2000_2022/
shots_data/pbp_shots_1997_2026/
shots_data/shotchart_detail/
# Third-party salary CSVs (Kaggle uploads of HoopsHype/Basketball-Reference data, no stated license) — kept local, not redistributed
nba_data/salaries/
# Kaggle "College Basketball Dataset" (team ratings scraped from barttorvik.com) — kept local, not redistributed
nba_data/college_teams/
# Local backups written before destructive reloads (load_kaggle_historical_seasons.py etc.)
scratchpad_backups/*_before_reload.csv
# The live season's daily fetch caches (scripts/daily_update.py): ESPN scoreboards and game summaries, nba_api frames,
# the shot chart per team; delete to re-fetch
live_data/
scratchpad_backups/player_id_map_*.csv
