{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "nba-frontend",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd frontend && npm run dev -- --port ${PORT:-5173} --strictPort"],
      "port": 5173,
      "autoPort": true
    },
    {
      "name": "impact-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd api && /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 -m uvicorn impact_api:app --port 8002"],
      "port": 8002
    },
    {
      "name": "mvp-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd api && /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 -m uvicorn mvp_api:app --port 8000"],
      "port": 8000
    },
    {
      "name": "similarity-api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "cd api && /Library/Frameworks/Python.framework/Versions/3.14/bin/python3 -m uvicorn similarity_api:app --port 8001"],
      "port": 8001
    }
  ]
}
